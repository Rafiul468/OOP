class Shop:
    shoppingmall = 'Jamuna'
    def __init__(self, buyer):
        self.buyer = buyer

        self.cart = []      #cart is a instance attributes.

    def add_to_cart (self, item):
        self.cart.append(item)


Rafi = Shop('Rafi')
Rafi.add_to_cart('Shoe')
Rafi.add_to_cart('phone')
print(Rafi.cart)

Rakib = Shop('Rakib')
Rakib.add_to_cart('Cap')
Rakib.add_to_cart('Watch')
print(Rakib.cart)
