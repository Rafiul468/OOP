# List, array, collection is same (simple terms)

# index    0  1  2  3  4  5  6  7
numbers = [12,58,45,26,51,23,4,54]
# index    -8 -7 -6 -5 -4 -3 -2 -1
print(numbers[3], numbers[-3])



#list(start : end)  # start from the start index and stop befor the end index
print(numbers[2:6])
print(numbers[-6:-1])

#list(start : end : step)
print(numbers[1:7:1])
print(numbers[1:7:2])
print(numbers[7:2:-1])
