class Product:
    def __init__(self, name, brand, price, category):
        self.name = name
        self.brand = brand
        self.price = price
        self.category = category

class Shop:
    def __init__(self, name, address, owner):
        self.name = name
        self.address = address
        self.owner = owner
        self.products = []

    def add_product (self, product):
        self.products.append(product)


# show product object
p1 = Product('Laptop', 'HP', 50000, 'Chaina')
p2 = Product('Mobile', 'Galaxy', 150000, 'India')
p3 = Product('Keyboard', 'Jedel', 450, 'Bangladesh')
p4 = Product('Mouse', 'Lenevo', 250, 'Pakistan')


# show shop object

my_shop = Shop('BD Gadget', 'Kurigram', 'Rafiul')

#Add product

my_shop.add_product(p1)
my_shop.add_product(p2)
my_shop.add_product(p3)
my_shop.add_product(p4)

#show product
for product in my_shop.products:
    print(product.name, product.brand, product.price, product.category)
