import pyautogui
import time

time.sleep(5)   # ৫ সেকেন্ডে Paint খুলে ক্যানভাসে মাউস রাখো, পেনসিল টুল সিলেক্ট করা থাকবে

distance = 200
while distance > 0:
    pyautogui.drag(distance, 0, duration=0.5)
    distance -= 5
    pyautogui.drag(0, distance, duration=0.5)
    pyautogui.drag(-distance, 0, duration=0.5)
    distance -= 5
    pyautogui.drag(0, -distance, duration=0.5)





