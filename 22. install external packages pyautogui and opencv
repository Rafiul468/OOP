import cv2
# Open the webcam
cam = cv2.VideoCapture(0)

while True:
    ret, frame = cam.read()

    if not ret:
        print("Camera not found!")
        break

    cv2.imshow("My Webcam", frame)

    # press q to exit 
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

    cam.release()
    cv2.destroyAllWindows()

