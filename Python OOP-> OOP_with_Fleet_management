class Travel:
    def __init__(self, brand, model, bus_id):
        self.brand = brand
        self.model = model
        self.bus_id = bus_id
        self.is_available = True


    def show_info (self):
        print("Brand: ", self.brand)
        print("Model: ", self.model)
        print("BUS ID: ", self.bus_id)


    def start_trip (self):
        if self.is_available:
            self.is_available = False
            print("Trip Started")
        else:
            print("Bus is Alrady in Use.")

    def end_trip (self):
        self.is_available = True
        print("Trip Ended.")



Bus = Travel('Toyota', 'Coralla', 101)

Bus.show_info()
Bus.start_trip()
