print(name)
print(marks)
print(passed)






#kargs & multiple:

def student_result(**kwargs):
    name = kwargs["name"]
    marks = kwargs["marks"]

    passed = marks >= 40

    return name, marks, passed

name, marks, passed = student_result(
    name="Rafi",
    marks=85
)

print("Name:", name)
print("Marks:", marks)
print("Passed:", passed)
