                    # OVERRIDING

class Person:
    def __init__(self, name, age, height, weight):
        self.name = name
        self.age = age
        self.height = height
        self.weight = weight

    def eat(self):
        print('They eat delisious food')

    def exersise(self):
        raise NotImplementedError


class Cricketer(Person):
    def __init__(self, name, age, height, weight,team):
        self.team = team
        super().__init__(name, age, height, weight)
    
    #Override
    def eat(self):
        print('They eat healthy food.')
    def exersise(self):
        print('Exercise is necessary for physical well-being')

        # + sign operator overload
    def __add__(self, other):   
        return self.age + other.age

        # * sign operator overload
    def __mul__(self, other):
        return self.height * other.height
        # len overload
    def __len__(self):
        return self.height
        # gt( > ) overload
    def __gt__(self, other):
        return self.age > other.age



Sakib_Al_Hasan = Cricketer('Sakib',33,58, 60,'Mayer Daa Cricket Team')
Mushfiqur_Rahim = Cricketer('Musfiqur', 34, 60, 62,'Baper Doa Cricket Team')


Sakib_Al_Hasan.eat()
Sakib_Al_Hasan.exersise()
print(Sakib_Al_Hasan + Mushfiqur_Rahim)
print(Sakib_Al_Hasan * Mushfiqur_Rahim)
print(len(Sakib_Al_Hasan))
print(Sakib_Al_Hasan > Mushfiqur_Rahim)
