class Exam:
    def __init__(self, attend):
        self.attend = attend
        self.min_attend = 292
        self.max_attend = 360

    def get_attend(self):
        return self.attend

    def daily_attend(self, regular):
        if regular > 0:
            self.attend += regular

    def non_attendance(self, regular):
        if regular > 0:
            self.attend -= regular

        if self.attend < self.min_attend:
            print("Your attendance is too low.")

        elif self.attend > self.max_attend:
            print("Your attendance is higher than expected.")

        else:
            print("You are eligible for the examination.")


ABC = Exam(290)

ABC.daily_attend(12)

ABC.non_attendance(5)

print("Total Attendance:", ABC.get_attend())

