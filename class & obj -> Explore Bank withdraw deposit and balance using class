class Bank:
    def __init__(self, balance):
        self.balance = balance
        self.min_withdrow = 100
        self.max_withdrow = 100000

    def get_balance(self):
        return self.balance

    def deposit(self, amount):
        if amount > 0:
            self.balance += amount

    def withdrow(self, amount):
        if amount < self.min_withdrow:
            print(f'You Can Withdrow Below: {self.min_withdrow}')

        elif amount > self.max_withdrow:
            print(f'This is not possible. You Can Withdrow Below: {self.max_withdrow}')

        else:
            self.balance -= amount
            print(f'here is your money: {amount}')
            print(f'The_City_Bangk !! Your balance after withdrow: {self.balance}')
            print(f'NRBC !! Your balance after deposit: {self.get_balance()}')



The_City_Bank = Bank(300000)
The_City_Bank.withdrow(50)
The_City_Bank.withdrow(30000000)
